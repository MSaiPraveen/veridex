# Server
PORT=3000
NODE_ENV=development

# JWT (verify only — issued by auth-service)
JWT_ACCESS_SECRET=access_secret

# MFA Encryption (REQUIRED in production - minimum 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=

# HTTPS Enforcement (set to 'true' to disable HTTPS redirect in production behind internal LB)
# DISABLE_HTTPS_REDIRECT=false

# Service URLs
AUTH_SERVICE_URL=http://auth-service:3001
USER_ORG_SERVICE_URL=http://user-org-service:3002
PRODUCT_SERVICE_URL=http://product-service:3003
DOCUMENT_SERVICE_URL=http://document-service:3004
COMPLIANCE_SERVICE_URL=http://compliance-service:3005
AUDIT_LOG_SERVICE_URL=http://audit-log-service:3006

# Redis (used for rate limiting)
REDIS_URL=redis://localhost:6379

# Timeouts (ms)
SERVICE_TIMEOUT=5000

# Frontend URLs (for CORS)
FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:4000
