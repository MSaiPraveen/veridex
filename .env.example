# ==============================================================================
# VERIDEX ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ==============================================================================

# ==============================================================================
# DATABASE
# ==============================================================================
# MongoDB Atlas connection strings (one per service for isolation)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>
MONGO_URI_AUTH=<your-mongodb-connection-string-for-auth-database>
MONGO_URI_USERS=<your-mongodb-connection-string-for-users-database>
MONGO_URI_PRODUCTS=<your-mongodb-connection-string-for-products-database>
MONGO_URI_DOCUMENTS=<your-mongodb-connection-string-for-documents-database>
MONGO_URI_COMPLIANCE=<your-mongodb-connection-string-for-compliance-database>
MONGO_URI_NOTIFICATIONS=<your-mongodb-connection-string-for-notifications-database>
MONGO_URI_AUDIT=<your-mongodb-connection-string-for-audit-database>

# ==============================================================================
# AUTHENTICATION
# ==============================================================================
# JWT secrets - MUST be random 32+ character strings
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=<generate-with-openssl-rand-hex-32>
JWT_REFRESH_SECRET=<generate-with-openssl-rand-hex-32>
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Internal service communication key
INTERNAL_SERVICE_KEY=<generate-random-internal-key>

# ==============================================================================
# MESSAGE BROKER
# ==============================================================================
KAFKA_BROKER=localhost:9092
# For Docker: kafka:9092

# ==============================================================================
# CACHE
# ==============================================================================
REDIS_URL=redis://localhost:6379
# For Docker: redis://redis:6379

# ==============================================================================
# SERVICE PORTS
# ==============================================================================
AUTH_SERVICE_PORT=3001
API_GATEWAY_PORT=3002
USER_SERVICE_PORT=3003
PRODUCT_SERVICE_PORT=3004
DOCUMENT_SERVICE_PORT=3005
COMPLIANCE_SERVICE_PORT=3006
NOTIFICATION_SERVICE_PORT=3007
AUDIT_SERVICE_PORT=3008

# ==============================================================================
# SERVICE URLS (for API Gateway)
# ==============================================================================
# Local development
AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3003
PRODUCT_SERVICE_URL=http://localhost:3004
DOCUMENT_SERVICE_URL=http://localhost:3005
COMPLIANCE_SERVICE_URL=http://localhost:3006
NOTIFICATION_SERVICE_URL=http://localhost:3007
AUDIT_SERVICE_URL=http://localhost:3008

# ==============================================================================
# FRONTEND
# ==============================================================================
NEXT_PUBLIC_API_URL=http://localhost:3002
FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:4000

# ==============================================================================
# FILE STORAGE
# ==============================================================================
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=10485760

# ==============================================================================
# EMAIL (Notification Service)
# ==============================================================================
SMTP_HOST=<your-smtp-host>
SMTP_PORT=587
SMTP_USER=<your-smtp-username>
SMTP_PASS=<your-smtp-password>
EMAIL_FROM=noreply@yourdomain.com

# ==============================================================================
# ENVIRONMENT
# ==============================================================================
NODE_ENV=development
